# Copy to .env.chat. Never prefix credentials with VITE_.
CERN_AI_KEY=
CERN_AI_BASE_URL=https://aigw.cern.ch/v1
# Choose an available model that supports streamed OpenAI tool calls.
CERN_AI_MODEL=

# Direct cluster/proxy MCP URL, NOT the OpenSearch Dashboards Dev Tools URL.
OPENSEARCH_MCP_URL=https://os-cmssdt.cern.ch/os/_plugins/_ml/mcp
# Optional service-specific headers; this is independent of CERN_AI_KEY.
OPENSEARCH_MCP_HEADERS={}
# Service/CLI mode: absolute path to a NEW token issued for this application
# with auth-get-user-token -c opensearch-cli -a itos_cmssdt -o FILE -x.
# The backend re-reads the file and verifies signature, issuer, expiry and aud.
OPENSEARCH_TOKEN_FILE=

# Optional per-user browser login. Register your OWN confidential CERN client.
# Request token-exchange permission to itos_cmssdt in the Application Portal.
# Leave all three empty when using service/CLI authentication.
CERN_OIDC_CLIENT_ID=
CERN_OIDC_CLIENT_SECRET=
CERN_OIDC_REDIRECT_URI=
# Example callback: https://YOUR_BACKEND/api/chat/auth/callback

CHAT_HOST=127.0.0.1
CHAT_PORT=8787
# For remote access, use a long random token and HTTPS/reverse proxy.
# Required beyond loopback in service/CLI mode. Enter it in Connection;
# it is kept in browser memory only. OIDC mode uses per-user sessions instead.
CHAT_ACCESS_TOKEN=
CHAT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://akritkbehera.github.io

# Per-operation timeout for OpenSearch MCP calls in milliseconds (default 120000).
CHAT_MCP_TIMEOUT_MS=120000
# Structured sanitized operation logs on stderr ('off' to silence).
CHAT_DIAGNOSTICS=

# Direct read-only PPL tool, alongside the unchanged native MCP tools.
# Endpoint defaults to the sibling path on the SAME OpenSearch origin.
CHAT_PPL_ENABLED=true
OPENSEARCH_PPL_URL=https://os-cmssdt.cern.ch/os/_plugins/_ppl
CHAT_PPL_TIMEOUT_MS=120000
CHAT_PPL_MAX_BYTES=131072
# Concrete names or narrowly scoped cmssdt family prefixes; never system indices.
CHAT_PPL_ALLOWED_INDICES=cmssdt-ib-matrix-*,cmssdt-ibs-*,cmssdt-ib-dataset-*,cmssdt-jenkins-jobs-*,cmssdt-jenkins-ibs-*,cmssdt-relvals_stats_summary-*,cmssdt-externals_stats_summary-*
